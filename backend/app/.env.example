# Project Configuration
# Project Configuration
PROJECT_NAME="AI Orchestration App"
VERSION="0.1.0"
API_V1_STR="/api/v1"
LOG_FILE_PATH="/app/logs/app.log"
ERROR_LOG_FILE_PATH="/app/logs/error.log"

# Database Configuration (MongoDB)
MONGODB_URL="mongodb://localhost:27017"
DATABASE_NAME="ai_app_db"

# Cache Configuration (Redis)
REDIS_URL="redis://localhost:6379/0"

# Security (JWT)
# Generate a secret key using: openssl rand -hex 32
SECRET_KEY="changethiskeyinproduction"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30

# LangSmith Configuration
LANGCHAIN_TRACING_V2=false
LANGCHAIN_ENDPOINT="https://api.smith.langchain.com"
LANGCHAIN_API_KEY=""
LANGEMINI_MODEL_NAME="gemini-2.5-flash"
OPENAI_API_KEY=your_openai_api_key_here

BACKEND_URL="https://animation-flow-r25n.vercel.app"
FRONTEND_URL="https://animation-flow-lac.vercel.app"
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000,https://animation-flow-lac.vercel.app,https://animation-flow-1pys.vercel.app"
